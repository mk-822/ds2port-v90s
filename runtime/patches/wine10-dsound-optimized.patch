+static UINT gcd_rate(UINT a, UINT b)
+{
+    while (b) { UINT remainder = a % b; a = b; b = remainder; }
+    return a;
+}
+
+static float *get_phase_cache(IDirectSoundBufferImpl *dsb, UINT stride, UINT divisor, UINT residue)
+{
+    UINT period = dsb->freqAdjustDen / divisor, phase, index, used, k;
+    float *table;
+    if (dsb->fir_phase_cache && dsb->fir_phase_num == dsb->freqAdjustNum &&
+        dsb->fir_phase_den == dsb->freqAdjustDen && dsb->fir_phase_step == dsb->firstep &&
+        dsb->fir_phase_residue == residue) return dsb->fir_phase_cache;
+    free(dsb->fir_phase_cache);
+    dsb->fir_phase_cache = NULL;
+    /* Bound per-voice storage to 1 MiB; uncommon pitch ratios use the stock path. */
+    if (period > 1024 || stride > 262144 / period) return NULL;
+    table = malloc((SIZE_T)period * stride * sizeof(float));
+    if (!table) return NULL;
+    for (phase = 0; phase < period; phase++)
+    {
+        UINT64 product = ((UINT64)phase * divisor + residue) * dsb->firstep;
+        UINT steps = product / dsb->freqAdjustDen;
+        float rem = steps + 1.0f - product / (float)dsb->freqAdjustDen;
+        float *row = table + phase * stride;
+        index = dsb->firstep - steps - 1;
+        used = 0;
+        for (k = index; k < fir_len - 1; k += dsb->firstep)
+            row[1 + used++] = fir[k] * (1.0f - rem) + fir[k + 1] * rem;
+        row[0] = used;
+    }
+    dsb->fir_phase_num = dsb->freqAdjustNum;
+    dsb->fir_phase_den = dsb->freqAdjustDen;
+    dsb->fir_phase_step = dsb->firstep;
+    dsb->fir_phase_residue = residue;
+    return dsb->fir_phase_cache = table;
 }
 
