</usr/share/alsa/alsa.conf>
pcm.jump3_dmix {
 type dmix
 ipc_key 486931
 ipc_perm 0600
 # The codec/DMA runs near 48k even when the kernel reports 44.1k. Use its
 # 48k domain and let the outer plug resample sources instead of raising pitch.
 slave { pcm "hw:0,0" rate 48000 format S16_LE channels 2 period_size 1024 buffer_size 4096 }
}
pcm_type.jump3_volume { lib "@@RUNTIME@@/native/lib/libasound_module_pcm_jump3_volume.so" }
pcm.jump3_volume { type jump3_volume slave.pcm "jump3_dmix" }
pcm.jump3_playback { type plug slave.pcm "jump3_volume" }
# PCM effects/music streams from Wine use 70%; the FM synth uses the full path.
pcm.jump3_pcm_gain {
 type route
 slave.pcm "jump3_volume"
 ttable.0.0 0.7
 ttable.1.1 0.7
}
pcm.jump3_pcm_playback { type plug slave.pcm "jump3_pcm_gain" }
