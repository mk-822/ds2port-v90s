#!/bin/sh
set -u
P=@@PORT@@
R=@@RUNTIME@@
C=$R/port
. "$C/env.sh"
backend=$(cat "$C/midi-backend" 2>/dev/null || echo opl3)
soundfont=
case "$backend" in
 opl3) ;;
 soundfont|timgm6mb) soundfont="$C/assets/TimGM6mb.sf2" ;;
 generaluser-gs) soundfont="$C/assets/GeneralUser-GS.sf2" ;;
 *) echo "Unknown MIDI backend: $backend"; exit 1 ;;
esac
if [ -n "$soundfont" ]; then
 for f in "$soundfont" "$R/native/bin/midisynth"; do
  [ -f "$f" ] || { echo "Missing $backend dependency: $f"; exit 1; }
 done
fi
midi_libs=
setup_midi(){
 midi_libs=$(mktemp -d /tmp/ds2port-midi.XXXXXX) || return 1
 python3 "$C/configure_midi.py" "$midi_libs"
}
cleanup_midi(){
 if [ -n "$midi_libs" ]; then
  rm -f "$midi_libs"/lib*.so.*
  rmdir "$midi_libs"
 fi
}
if [ "${1:-}" = --check ]; then
 for f in "$P/game/"@@EXE@@ "$W/bin/wine" "$C/runtime/box64" "$C/runtime/dsfont.dll" "$C/runtime/dsound.dll" "$R/native/bin/Xvfb" "$R/native/bin/fbbridge" "$R/native/bin/sb16-synth" "$R/native/bin/audio-mixer" "$R/native/lib/libasound_module_pcm_ds2port_mix.so" "$C/assets/fonts/msgothic.ttc"; do
  [ -f "$f" ] || { echo "Missing: $f"; exit 1; }
 done
 if [ -n "$soundfont" ]; then
  trap cleanup_midi EXIT
  setup_midi || exit 1
 fi
 echo 'DS2PORT_RUNTIME_OK'
 exit 0
fi
lock=/run/plumos/ds2port-display93.lock
mkdir "$lock" 2>/dev/null || { echo 'Another DS2Port game is running'; exit 1; }
xpid=;spid=;bpid=;gpid=;apid=
prefix_active=0
stop_wine(){
 timeout -k 2 10 "$R/wineserver-wrapper" -k >/dev/null 2>&1 || true
 timeout -k 2 15 "$R/wineserver-wrapper" -w >/dev/null 2>&1
}
cleanup(){
 trap - EXIT HUP INT TERM
 # Stop the Wine launcher before requesting server shutdown. Otherwise a
 # launcher still starting the game can race the server shutdown request.
 if [ -n "$gpid" ]; then
  kill "$gpid" 2>/dev/null || true
 fi
 if [ "$prefix_active" = 1 ] && ! stop_wine; then
  echo 'WINE_CLEANUP_RETRY'
  stop_wine || echo 'WINE_CLEANUP_FAILED'
 fi
 for pid in "$bpid" "$spid" "$xpid" "$apid"; do
  [ -n "$pid" ] && kill "$pid" 2>/dev/null || true
 done
 for pid in "$gpid" "$bpid" "$spid" "$xpid" "$apid"; do
  [ -z "$pid" ] || wait "$pid" 2>/dev/null || true
 done
 rm -f "$R/audio.pid"
 rm -f "$R/game.pid" "$R/bridge.pid" "$R/synth.pid" "$R/xvfb.pid"
 rm -f "$R/bridge.ready" "$R/viewport" "$R/viewport.new"
 cleanup_midi
 if [ "$prefix_active" = 1 ]; then
  python3 "$C/prefix_storage.py" unmount "$S" || echo 'PREFIX_UNMOUNT_FAILED'
 fi
 rmdir "$lock" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM
[ ! -d "$R/.ds2port-install.lock" ] || { echo "DS2Port installation is in progress"; exit 1; }
python3 "$C/common_prefix.py" "$R" || exit 1
prefix_active=1
python3 "$C/prefix_storage.py" ensure "$S" || exit 1
# Keep the OS cache/registry writable, including Wineboot's first-run growth.
python3 - "$S" <<'PY' || exit 1
from pathlib import Path
import shutil,sys
runtime=Path(sys.argv[1]);prefix=runtime/'prefix'
existing=sum(p.stat().st_size for p in prefix.rglob('*') if not p.is_symlink() and p.is_file()) if prefix.exists() else 0
ready=(runtime/'prefix-configured-v2').is_file() and all((prefix/name).is_file() for name in ('system.reg','user.reg'))
needed=(0 if ready else max(0,640*1024**2-existing))+128*1024**2
if shutil.disk_usage(runtime).free<needed:
    sys.exit('Insufficient ext4 space for Wine startup; need %.0f MiB free.'%(needed/1024**2))
PY
mkdir -p "$R/logs" || exit 1
# Append avoids deleting FAT chains on every start; logs can be exported from SSH.
exec >> "$R/logs/launch.log" 2>&1
echo "DS2Port launch $(date -u)"
if [ -S /tmp/.X11-unix/X93 ]; then echo 'Display 93 is already in use'; exit 1; fi
unset LD_PRELOAD SDL_HQ_SCALER SDL_ROTATION SDL_BLITTER_DISABLED
/mnt/plumos/bin/plumos-audio-output prepare || true
python3 "$C/configure_audio.py" "$R" || exit 1
if [ "$(cat "$C/audio-output-mode")" = shared-mixer ]; then
 if [ -f "$R/audio.pid" ]; then
  previous=$(cat "$R/audio.pid")
  case "$previous" in ''|*[!0-9]*) ;; *)
   [ "$(cat "/proc/$previous/comm" 2>/dev/null)" != audio-mixer ] || { echo 'Audio mixer already running'; exit 1; }
  esac
 fi
 [ ! -L "$R/audio.sock" ] || { echo 'Invalid audio socket'; exit 1; }
 if [ -e "$R/audio.sock" ]; then
  [ -S "$R/audio.sock" ] || { echo 'Invalid audio socket'; exit 1; }
  rm -f "$R/audio.sock"
 fi
 ALSA_CONFIG_PATH="$C/asound-output.conf" audio-mixer "$R/audio.sock" ds2port_output >> "$R/logs/audio-mixer.log" 2>&1 &
 apid=$!; echo "$apid" > "$R/audio.pid"
 for i in $(seq 1 30); do
  [ -S "$R/audio.sock" ] && break
  kill -0 "$apid" 2>/dev/null || { echo 'Audio mixer failed'; exit 1; }
  sleep .1
 done
 [ -S "$R/audio.sock" ] || { echo 'Audio mixer did not become ready'; exit 1; }
fi
mkdir -p /tmp/.X11-unix
ln -sfn "$R/native/bin" /tmp/j3b
track_viewport=@@TRACK_VIEWPORT@@
display_depth=24
# CJ16's fixed viewport uses an RGB565 DirectDraw surface. Match it in Xvfb
# when the native bridge can convert RGB565 to the panel's 32-bit format.
if [ "$track_viewport" = no ] && [ -f "$R/native/share/xvfb-rgb565" ]; then
 display_depth=16
fi
echo "XVFB_DISPLAY_DEPTH=$display_depth"
Xvfb :93 -screen 0 "640x480x$display_depth" -xkbdir "$XKB_CONFIG_ROOT" -ac -nolisten tcp -noreset >> "$R/logs/xvfb.log" 2>&1 &
xpid=$!; echo "$xpid" > "$R/xvfb.pid"
ready=0
for i in $(seq 1 10); do
 if timeout 3 xwininfo -root >/dev/null 2>&1; then ready=1; break; fi
 sleep 1
done
[ "$ready" = 1 ] || { echo 'Xvfb failed'; exit 1; }
rm -f "$R/bridge.ready" "$R/viewport" "$R/viewport.new"
DS2PORT_BRIDGE_READY="$R/bridge.ready" DS2PORT_VIEWPORT_FILE="$R/viewport" fbbridge >> "$R/logs/framebuffer.log" 2>&1 &
bpid=$!; echo "$bpid" > "$R/bridge.pid"
for i in $(seq 1 30); do
 [ -f "$R/bridge.ready" ] && break
 kill -0 "$bpid" 2>/dev/null || { echo 'Input bridge failed'; exit 1; }
 sleep .1
done
[ -f "$R/bridge.ready" ] || { echo 'Input bridge did not become ready'; exit 1; }
mkdir -p "$WINEPREFIX/drive_c/windows/Fonts"
if ! cmp -s "$C/assets/fonts/msgothic.ttc" "$WINEPREFIX/drive_c/windows/Fonts/msgothic.ttc"; then
 cp "$C/assets/fonts/msgothic.ttc" "$WINEPREFIX/drive_c/windows/Fonts/msgothic.ttc"
fi
if [ ! -f "$S/prefix-configured-v2" ] || [ ! -f "$WINEPREFIX/system.reg" ] || [ ! -f "$WINEPREFIX/user.reg" ]; then
 wine_run wineboot.exe --init >> "$R/logs/prefix.log" 2>&1 || true
 stop_wine || { echo 'Wine initialization did not stop'; exit 1; }
 python3 "$C/configure_prefix.py" "$WINEPREFIX" >> "$R/logs/prefix.log" 2>&1 || { echo 'Japanese prefix setup failed'; exit 1; }
 touch "$S/prefix-configured-v2"
fi
# Wineboot writes its first private environment before builtin DLLs are shared.
python3 "$C/prefix_storage.py" ensure "$S" || exit 1
# Native Win32 import adapter; copy atomically into this prefix's private layer.
font_dll="$WINEPREFIX/drive_c/windows/syswow64/dsfont.dll"
if ! cmp -s "$C/runtime/dsfont.dll" "$font_dll"; then
 cp "$C/runtime/dsfont.dll" "$font_dll.ds2port-new" && mv "$font_dll.ds2port-new" "$font_dll" || exit 1
fi
# One DirectSound module in the common prefix serves every updated title.
audio_dll="$WINEPREFIX/drive_c/windows/syswow64/dsound.dll"
if ! cmp -s "$C/runtime/dsound.dll" "$audio_dll"; then
 cp "$C/runtime/dsound.dll" "$audio_dll.ds2port-new" && mv "$audio_dll.ds2port-new" "$audio_dll" || exit 1
fi
midi_log="$R/logs/midi.log"
touch "$midi_log" || exit 1
midi_start=$(wc -c < "$midi_log") || exit 1
echo "MIDI_BACKEND=$backend" >> "$midi_log"
if [ -n "$soundfont" ]; then
 setup_midi || exit 1
 LD_LIBRARY_PATH="$midi_libs:$LD_LIBRARY_PATH" ALSA_CONFIG_PATH="$C/asound-fm.conf" \
  midisynth "$soundfont" >> "$midi_log" 2>&1 &
else
 ALSA_CONFIG_PATH="$C/asound-fm.conf" sb16-synth >> "$midi_log" 2>&1 &
fi
spid=$!; echo "$spid" > "$R/synth.pid"
midi_ready=0
for i in $(seq 1 100); do
 kill -0 "$spid" 2>/dev/null || { echo "MIDI synth failed: $backend (see midi.log)"; exit 1; }
 if tail -c "+$((midi_start + 1))" "$midi_log" | grep -q '^MIDI_SYNTH_READY'; then
  midi_ready=1
  break
 fi
 sleep .1
done
[ "$midi_ready" = 1 ] || { echo "MIDI synth did not become ready: $backend"; exit 1; }
cd "$P/game" || exit 1
@@GAME_ENV@@
if [ "$track_viewport" = yes ] && [ -f "$R/native/window-runner.exe" ]; then
 DS2PORT_VIEWPORT="Z:$R/viewport" "$C/runtime/box64" "$W/bin/wine" "Z:$R/native/window-runner.exe" @@EXE@@ >> "$R/logs/game.log" 2>&1 &
else
 [ "$track_viewport" = no ] || echo 'Virtual fullscreen requires an updated runtime bundle.'
 "$C/runtime/box64" "$W/bin/wine" @@EXE@@ >> "$R/logs/game.log" 2>&1 &
fi
gpid=$!; echo "$gpid" > "$R/game.pid"
while kill -0 "$gpid" 2>/dev/null && kill -0 "$bpid" 2>/dev/null; do sleep 1; done
echo "DS2Port stopped $(date -u)"
