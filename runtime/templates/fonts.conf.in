<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>
 <dir>@@RUNTIME@@/wine-10.0-amd64-wow64/share/wine/fonts</dir>
 <dir>@@RUNTIME@@/port/assets/fonts</dir>
 <cachedir>@@RUNTIME@@/fontcache</cachedir>
 <alias><family>sans-serif</family><prefer><family>MS Gothic</family></prefer></alias>
 <alias><family>ＭＳ ゴシック</family><prefer><family>MS Gothic</family></prefer></alias>
</fontconfig>
