#!/bin/sh
P=@@PORT@@
R=@@RUNTIME@@
C=$R/port
S=/mnt/plumos/ports-runtime/.shared/wine10
W=$R/wine-10.0-amd64-wow64
export LD_LIBRARY_PATH=$R/native/lib:/mnt/plumos/lib/plumos-sdl2-powervr:/mnt/plumos/lib:/usr/lib/aarch64-linux-gnu
export BOX64_LD_LIBRARY_PATH=$C/runtime/x64lib
export BOX64_LOG=0
export BOX64_DYNAREC=1
export WINEPREFIX=$S/prefix
export WINEDLLOVERRIDES='dsound=b;mscoree,mshtml='
export WINEDEBUG=-all
export LC_ALL=ja_JP.UTF-8
export DISPLAY=unix/:93
export XKB_CONFIG_ROOT=$R/native/share/X11/xkb
export FONTCONFIG_FILE=$C/fonts.conf
export WINE_D3D_CONFIG='renderer=gdi'
export ALSA_CONFIG_PATH=$C/asound.conf
export ALSA_PLUGIN_DIR=/mnt/plumos/lib/alsa-lib
export PATH=$R/native/bin:$W/bin:$C/runtime:$PATH
export WINESERVER=$R/wineserver-wrapper
export DS2PORT_INPUT_MODE=$(cat "$C/input-mode" 2>/dev/null || echo mouse)
export SDL_GAMECONTROLLER_IGNORE_DEVICES_EXCEPT=0x1209/0xd590
wine_run() { "$C/runtime/box64" "$W/bin/wine" "$@"; }
