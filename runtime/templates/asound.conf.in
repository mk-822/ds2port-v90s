</usr/share/alsa/alsa.conf>
pcm.jump3_dmix {
 type dmix
 ipc_key 486931
 ipc_perm 0600
 slave { pcm "hw:0,0" rate 44100 format S16_LE channels 2 period_size 1024 buffer_size 4096 }
}
pcm_type.jump3_volume { lib "@@RUNTIME@@/native/lib/libasound_module_pcm_jump3_volume.so" }
pcm.jump3_volume { type jump3_volume slave.pcm "jump3_dmix" }
pcm.jump3_playback { type plug slave.pcm "jump3_volume" }
pcm.!default { type asym playback.pcm "jump3_playback" capture.pcm "plughw:0,0" }
ctl.!default { type hw card 0 }
